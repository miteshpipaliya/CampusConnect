# Environment names only. NEVER add real IDs, tokens or keys to GitHub.
# Set these values as Vercel environment variables or in a gitignored .env.local.
# Firebase web key is used ONLY in server-side authentication routes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Server-only Resend email OTP configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OTP_SIGNING_SECRET=

# Stream Chat credentials (server-only; never prefix with NEXT_PUBLIC_)
STREAM_API_KEY=
STREAM_API_SECRET=

# Optional Phase 1 foundation configuration
CRON_SECRET=
CRON_DELETE_ENABLED=
STORAGE_PROVIDER=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Phase 2: personal test-account emails are server-only, comma separated
APPROVED_TEST_EMAILS=
# Keep disabled unless Stream SDK client permissions and two-way blocking were reviewed
STREAM_CLIENT_TOKENS_ENABLED=false
# Independent opt-in for permanent account purges; also requires CRON_DELETE_ENABLED=true
CRON_PURGE_ACCOUNTS_ENABLED=false

# Optional opt-in browser push. Match web project to server project. Never use service account key here.
FCM_PUSH_ENABLED=false
FIREBASE_WEB_PUSH_VAPID_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Optional stable referral signing/ledger key (>=32 characters); falls back to OTP_SIGNING_SECRET.
# Choose once before launch; rotation requires migrating the keyed student ledger.
REFERRAL_SIGNING_SECRET=
