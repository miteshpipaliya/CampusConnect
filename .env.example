# Environment names only. NEVER add real IDs, tokens or keys to GitHub.
# Set these values as Vercel environment variables or in a gitignored .env.local.
# Firebase web key is used ONLY in server-side authentication routes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Server-only Resend email OTP configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OTP_SIGNING_SECRET=
